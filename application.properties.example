spring.application.name=yuyukoshop

# Server
server.port=8080

# MySQL Database
# 本机建库：CREATE DATABASE yuyukoshop CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
# 建表与初始数据见 src/main/resources/db/（先 schema.sql，再 seed_data.sql）
spring.datasource.url=jdbc:mysql://localhost:3306/yuyukoshop?useUnicode=true&characterEncoding=utf-8&useSSL=false&serverTimezone=Asia/Shanghai
spring.datasource.username=YOUR_DB_USERNAME
spring.datasource.password=YOUR_DB_PASSWORD
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# Exclude Redis when not available
# 仓库里带了 spring-boot-starter-data-redis，但默认不启用缓存。要启用就先装 Redis，
# 再把这段 exclude 删掉、解开下面的 spring.redis.* 配置。
spring.autoconfigure.exclude=org.springframework.boot.autoconfigure.data.redis.RedisAutoConfiguration,org.springframework.boot.autoconfigure.data.redis.RedisRepositoriesAutoConfiguration

# MyBatis-Plus
mybatis-plus.mapper-locations=classpath:/mapper/**/*.xml
mybatis-plus.type-aliases-package=com.yuyukoshop.yuyukoshop.entity
mybatis-plus.configuration.map-underscore-to-camel-case=true
mybatis-plus.configuration.log-impl=org.apache.ibatis.logging.stdout.StdOutImpl
mybatis-plus.global-config.db-config.id-type=auto
mybatis-plus.global-config.db-config.logic-delete-field=deleted
mybatis-plus.global-config.db-config.logic-delete-value=1
mybatis-plus.global-config.db-config.logic-not-delete-value=0

# Redis（取消注释以启用 Redis 缓存，同时要删掉上面的 spring.autoconfigure.exclude）
#spring.redis.host=localhost
#spring.redis.port=6379
#spring.redis.database=0
#spring.redis.timeout=3000ms
#spring.redis.lettuce.pool.max-active=8
#spring.redis.lettuce.pool.max-idle=8
#spring.redis.lettuce.pool.min-idle=0

# JWT
# 任意足够长的随机串即可，例如：openssl rand -base64 48
jwt.secret=YOUR_JWT_SECRET
jwt.expiration=86400000

# Jackson
spring.jackson.date-format=yyyy-MM-dd HH:mm:ss
spring.jackson.time-zone=Asia/Shanghai
spring.jackson.serialization.write-dates-as-timestamps=false

# File Upload (for product images)
spring.servlet.multipart.max-file-size=10MB
spring.servlet.multipart.max-request-size=100MB

# Logging
logging.level.com.yuyukoshop.yuyukoshop.mapper=debug

# CORS Configuration - 允许的前端地址（多个用逗号分隔）
cors.allowed-origins=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# ==================== Alipay Configuration ====================
# 以下四项都需要自己申请。不配置时，除支付以外的功能都能正常跑。
# 沙箱应用：https://open.alipay.com/develop/sandbox/app
#
# 支付宝应用 ID（沙箱应用页面获取）
alipay.app-id=YOUR_ALIPAY_APP_ID
# 商户 RSA2 私钥（应用私钥，PKCS8 格式，单行不要换行）
alipay.private-key=YOUR_ALIPAY_PRIVATE_KEY
# 支付宝公钥（开放平台获取，不是应用公钥）
alipay.alipay-public-key=YOUR_ALIPAY_PUBLIC_KEY
# 支付宝网关（沙箱环境）
alipay.server-url=https://openapi-sandbox.dl.alipaydev.com/gateway.do
# 支付成功后同步回调地址（用户浏览器跳转）
alipay.return-url=http://localhost:8080/api/payment/return
# 支付成功后异步通知地址（必须外网可访问；本地开发需要内网穿透）
alipay.notify-url=YOUR_PUBLIC_NOTIFY_URL
