<template>
  <div class="order-detail-page">
    <NavHeader />
    <div class="cyber-container" v-loading="loading">
      <!-- 返回导航 -->
      <div class="back-nav" @click="$router.push('/orders')">
        <span class="back-arrow">&#8592;</span>
        <span class="back-text">返回订单列表</span>
        <span class="back-line"></span>
      </div>

      <!-- 页面标题 -->
      <div class="page-header">
        <div class="header-decoration">
          <span class="deco-line"></span>
          <span class="deco-diamond"></span>
          <span class="deco-line"></span>
        </div>
        <h2 class="page-title">
          <span class="title-icon">&#9830;</span>
          订单详情
          <span class="title-icon">&#9830;</span>
        </h2>
        <p class="page-subtitle">ORDER DETAIL</p>
      </div>

      <template v-if="order">
        <!-- 订单信息卡片 -->
        <div class="glass-card info-card">
          <div class="card-title-bar">
            <div class="title-left">
              <span class="title-indicator"></span>
              <span class="title-text">订单信息</span>
              <span class="title-en">ORDER INFO</span>
            </div>
            <span :class="['neon-badge', `badge-${order.status}`]">
              <span class="badge-dot"></span>
              {{ order.statusText }}
            </span>
          </div>

          <div class="info-grid">
            <div class="info-item">
              <span class="info-label">订单编号</span>
              <span class="info-value order-no-val">{{ order.orderNo }}</span>
            </div>
            <div class="info-item">
              <span class="info-label">下单时间</span>
              <span class="info-value">{{ order.createTime }}</span>
            </div>
            <div class="info-item">
              <span class="info-label">收货人</span>
              <span class="info-value">{{ order.receiverName }}</span>
            </div>
            <div class="info-item">
              <span class="info-label">联系电话</span>
              <span class="info-value">{{ order.receiverPhone }}</span>
            </div>
            <div class="info-item full-width">
              <span class="info-label">收货地址</span>
              <span class="info-value">{{ order.shippingAddress }}</span>
            </div>
            <div class="info-item">
              <span class="info-label">订单金额</span>
              <span class="info-value price-value">¥{{ order.totalAmount }}</span>
            </div>
            <div class="info-item">
              <span class="info-label">支付方式</span>
              <span class="info-value">{{ order.paymentMethod || '在线支付' }}</span>
            </div>
            <div class="info-item full-width">
              <span class="info-label">备注</span>
              <span class="info-value remark-val">{{ order.remark || '无' }}</span>
            </div>
          </div>
        </div>

        <!-- 物流信息 -->
        <LogisticsInfo
          v-if="order.status >= 2 && order.trackingNo"
          :order-id="order.id"
        />

        <!-- 商品清单卡片 -->
        <div class="glass-card items-card">
          <div class="card-title-bar">
            <div class="title-left">
              <span class="title-indicator"></span>
              <span class="title-text">商品清单</span>
              <span class="title-en">PRODUCTS</span>
            </div>
          </div>

          <div class="items-list">
            <div
              v-for="(item, index) in order.items"
              :key="item.id"
              class="product-row"
              :style="{ animationDelay: `${index * 0.1}s` }"
            >
              <div class="product-image-wrapper">
                <el-image
                  :src="item.productThumbnail || 'https://via.placeholder.com/60x60?text=No+Image'"
                  fit="cover"
                  class="product-image"
                />
                <div class="image-scanline"></div>
                <div class="image-index">{{ String(index + 1).padStart(2, '0') }}</div>
              </div>
              <div class="product-detail">
                <div class="product-name">{{ item.productName }}</div>
                <div class="product-price-row">
                  <span class="product-unit-price">¥{{ item.price }}</span>
                  <span class="product-qty">x {{ item.quantity }}</span>
                </div>
              </div>
              <div class="product-subtotal">
                <span class="subtotal-label">小计</span>
                <span class="subtotal-amount">¥{{ item.subtotal || (item.price * item.quantity).toFixed(2) }}</span>
              </div>
            </div>
          </div>

          <!-- 订单总计 -->
          <div class="order-total-bar">
            <div class="total-decoration"></div>
            <span class="total-label">订单总计</span>
            <span class="total-amount">¥{{ order.totalAmount }}</span>
          </div>
        </div>

        <!-- 操作按钮 -->
        <div class="action-bar" v-if="order">
          <button
            v-if="order.status === 0"
            class="cyber-btn neon-cyan lg"
            @click="goToPay"
          >
            <span class="btn-glow"></span>
            <span class="btn-icon">&#9654;</span>
            立即支付
          </button>
          <button
            v-if="order.status === 0"
            class="cyber-btn outline lg"
            @click="cancelOrder"
          >
            取消订单
          </button>
          <button
            v-if="order.status === 2"
            class="cyber-btn neon-green lg"
            @click="confirmReceive"
          >
            <span class="btn-glow"></span>
            <span class="btn-icon">&#10003;</span>
            确认收货
          </button>
          <button
            v-if="order.status >= 2 && order.status <= 3"
            class="cyber-btn neon-gold lg"
            @click="requestRefund"
          >
            <span class="btn-glow"></span>
            <span class="btn-icon">&#8635;</span>
            申请退款
          </button>
        </div>
      </template>
    </div>
  </div>
</template>

<script setup>
import NavHeader from '@/components/NavHeader.vue'
import LogisticsInfo from '@/components/LogisticsInfo.vue'
import request from '@/api/request'
import { ref, onMounted } from 'vue'
import { useRoute, useRouter } from 'vue-router'
import { ElMessage, ElMessageBox } from 'element-plus'

const route = useRoute()
const router = useRouter()
const order = ref(null)
const loading = ref(false)

const statusType = (status) => {
  const map = {
    0: 'warning',   // 待支付
    1: 'primary',   // 已支付
    2: 'success',   // 已发货
    3: 'success',   // 已完成
    4: 'warning',   // 退款中
    5: 'info',      // 已退款
    '-1': 'danger'  // 已取消
  }
  return map[status] || 'info'
}

const fetchOrder = async () => {
  loading.value = true
  try {
    const res = await request.get(`/orders/${route.params.id}`)
    order.value = res.data
  } catch (e) {
    ElMessage.error('获取订单详情失败')
    console.error(e)
  } finally {
    loading.value = false
  }
}

const goToPay = () => {
  router.push(`/orders/${order.value.id}/pay`)
}

const cancelOrder = async () => {
  try {
    await ElMessageBox.confirm('确认取消该订单吗？', '提示', { type: 'warning' })
    await request.put(`/orders/${order.value.id}/cancel`)
    ElMessage.success('订单已取消')
    fetchOrder()
  } catch (e) {
    if (e !== 'cancel') console.error(e)
  }
}

const confirmReceive = async () => {
  try {
    await ElMessageBox.confirm('确认已收到商品吗？', '提示', { type: 'warning' })
    await request.put(`/orders/${order.value.id}/receive`)
    ElMessage.success('确认收货成功')
    fetchOrder()
  } catch (e) {
    if (e !== 'cancel') console.error(e)
  }
}

const requestRefund = async () => {
  try {
    const { value } = await ElMessageBox.prompt('请输入退款原因', '申请退款', {
      confirmButtonText: '提交',
      cancelButtonText: '取消',
      inputPattern: /\S+/,
      inputErrorMessage: '请输入退款原因'
    })
    await request.post(`/orders/${order.value.id}/refund`, { reason: value })
    ElMessage.success('退款申请已提交')
    fetchOrder()
  } catch (e) {
    if (e !== 'cancel') console.error(e)
  }
}

onMounted(fetchOrder)
</script>

